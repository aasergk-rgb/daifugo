# ビルド時の設定（Vercel では Project Settings → Environment Variables に入れる）
# どれも省略可能。省略すると P2P（PeerJS 公開サーバー）でオンライン対戦します。

# 別の場所に置いた対戦サーバー（npm start / Docker / Render）を使う場合
# VITE_SERVER_URL=https://daifugo-server.onrender.com

# WebRTC の接続補助サーバー（つながりにくいネットワーク向けの TURN など）を JSON で
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]

# 自前の PeerJS シグナリングサーバーを使う場合
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
